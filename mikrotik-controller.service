[Unit]
Description=MikroTik Controller - Router Management Web App
After=network.target

[Service]
Type=simple
User=mikrotik
Group=mikrotik
WorkingDirectory=/opt/mikrotik-controller
ExecStart=/opt/mikrotik-controller/mikrotik-controller
Restart=on-failure
RestartSec=5
Environment=MIKROTIK_PORT=8080
# PostgreSQL connection (the app uses the pgx driver; there is no SQLite DB path)
Environment=PISOWIFI_DB_HOST=localhost
Environment=PISOWIFI_DB_PORT=5432
Environment=PISOWIFI_DB_USER=pisowifi
Environment=PISOWIFI_DB_PASSWORD=pisowifi
Environment=PISOWIFI_DB_NAME=pisowifi

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/mikrotik-controller
ProtectHome=true

[Install]
WantedBy=multi-user.target
