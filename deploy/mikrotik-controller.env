###############################################################################
# MikroTik Controller - environment configuration
#
# Copy this file to /etc/default/mikrotik-controller (install.sh does this)
# and edit the values as needed, then `systemctl restart mikrotik-controller`.
###############################################################################

# TCP port the web UI listens on (default 8080)
MIKROTIK_PORT=8080

# PostgreSQL connection.
# The app auto-migrates its schema on startup, so a fresh,
# empty database is sufficient - no manual SQL required.
PISOWIFI_DB_HOST=localhost
PISOWIFI_DB_PORT=5432
PISOWIFI_DB_USER=pisowifi
PISOWIFI_DB_PASSWORD=pisowifi
PISOWIFI_DB_NAME=pisowifi
